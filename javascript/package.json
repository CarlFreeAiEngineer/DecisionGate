{
  "name": "decisiongate",
  "version": "0.4.1",
  "description": "Your software probably needs this. Offline yes/no decisions.",
  "license": "Apache-2.0",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./web": {
      "types": "./web/index.d.ts",
      "import": "./web/index.js"
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "native",
    "README.md",
    "LICENSE",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:release": "node pack.mjs"
  },
  "devDependencies": {
    "node": "24.14.0",
    "typescript": "5.9.3"
  }
}
